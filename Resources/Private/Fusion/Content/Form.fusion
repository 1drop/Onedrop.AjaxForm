prototype(Onedrop.AjaxForm:Form) < prototype(Neos.NodeTypes.Form:Form) {
    # Deprecated alias of "formPresetName", kept for backwards compatibility
    presetName = null
    formPresetName.@process.legacyPresetName = ${this.presetName ? this.presetName : value}

    # Passed to the ajax endpoint to render the form in the same language as the page
    locale = ${node.dimensionSpacePoint.coordinates.language}

    formWrapperAttributes = Neos.Fusion:DataStructure

    @private {
        overrideConfigurationIdentifier = ${Onedrop.AjaxForm.storeOverrideConfiguration(props.formIdentifier, props.overrideConfiguration)}
        ajaxUri = Neos.Fusion:ActionUri {
            package = 'Onedrop.AjaxForm'
            controller = 'AjaxForm'
            action = 'index'
            format = 'html'
            arguments = Neos.Fusion:DataStructure {
                formIdentifier = ${props.formIdentifier}
                presetName = ${props.formPresetName}
                locale = ${props.locale}
                locale.@if.isSet = ${props.locale}
                overrideConfiguration = ${private.overrideConfigurationIdentifier}
                overrideConfiguration.@if.isSet = ${private.overrideConfigurationIdentifier}
            }
        }
    }

    renderer = afx`
        <div {...props.attributes}>
            <p @if.showEditHint={!props.formIdentifier && renderingMode.isEdit}>
                {Translation.id('content.noValidFormIdentifier').package('Neos.NodeTypes.Form').source('NodeTypes/Form')}
            </p>
            <div @if.hasForm={props.formIdentifier} {...props.formWrapperAttributes} data-ajax="ajax-form" data-ajax-uri={private.ajaxUri}>
                <Neos.Fusion:Template templatePath={props.templatePath}
                                      formIdentifier={props.formIdentifier}
                                      presetName={props.formPresetName}
                                      overrideConfiguration={props.overrideConfiguration}/>
            </div>
        </div>
    `
}
